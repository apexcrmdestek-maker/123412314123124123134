# GEMINI_API_KEY: Optional. If omitted the app uses a safe local mock for AI features.
# AI Studio can inject this at runtime from user secrets if you want real Gemini calls.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
